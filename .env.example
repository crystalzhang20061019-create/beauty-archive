DJANGO_SECRET_KEY=replace-with-a-long-random-secret
DJANGO_DEBUG=1
DJANGO_ALLOWED_HOSTS=127.0.0.1,localhost
DJANGO_CSRF_TRUSTED_ORIGINS=
# Leave DATABASE_URL unset to use the local SQLite database.
# DATABASE_URL=postgresql://beauty_archive:your-password@localhost:5432/beauty_archive
EXCHANGE_RATE_API_KEY=
# Production only: use Supabase PostgreSQL + a private Supabase Storage bucket.
# USE_SUPABASE_STORAGE=1
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_STORAGE_BUCKET_NAME=beauty-archive-private
# AWS_S3_ENDPOINT_URL=https://PROJECT_REF.storage.supabase.co/storage/v1/s3
# AWS_S3_REGION_NAME=region-from-supabase-storage-settings
